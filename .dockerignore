.gitignore
.venv
venv
**/__pycache__
**/*.py[cod]
.pytest_cache
.ruff_cache
.serena
.claude
.vscode
.idea

.env
.env.*

data/
logs/
evaluation/
tests/
deploy/
docs/
NUL

Dockerfile
docker-compose*.yml
*.md
requirements-dev.txt
