# Optional -- Vervemint runs without a .env file.
#
# API keys, the Telegram bot and the web UI password are set in the web
# UI's Settings page, and the API token is generated on the first start.
# Copy this file to .env (next to docker-compose.yml) only for the options
# below. Never commit .env.

# Optional parts of the Docker stack, comma separated:
#   proxy   HTTPS on your own domain (Caddy)
#   ollama  a local LLM server in a container
COMPOSE_PROFILES=

# For the proxy: your domain. Its DNS record must point at this server,
# and ports 80 and 443 must be open.
DOMAIN=

# Ports published on 127.0.0.1. Change them if something else on this
# machine already uses one (e.g. a local `streamlit run ui/app.py`),
# otherwise Docker reports "ports are not available ... bind".
# API_PORT=8000
# UI_PORT=8501

# Ollama server the API uses. It is normally set in the Settings page;
# a value here overrides it and locks that field. In Docker with the
# "ollama" profile, use http://ollama:11434.
# OLLAMA_HOST=http://ollama:11434

# Advanced: a secret set here (e.g. injected by a secrets manager) wins
# over the Settings page and locks that field there.
# GEMINI_API_KEY=
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# VERVEMINT_TELEGRAM_BOT_TOKEN=
# VERVEMINT_TELEGRAM_ALLOWED_USERS=
# VERVEMINT_UI_PASSWORD=
# VERVEMINT_API_TOKEN=
